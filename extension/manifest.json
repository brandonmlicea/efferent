{
	"manifest_version": 3,
	"name": "efferent",
	"version": "2.0.0",
	"description": "Claude in your own browser",
	"key": "",
	"minimum_chrome_version": "120",
	"background": { "service_worker": "background.js", "type": "module" },
	"permissions": ["tabs", "scripting", "debugger", "alarms", "storage", "userScripts", "webNavigation"],
	"host_permissions": ["<all_urls>"],
	"action": { "default_title": "efferent", "default_popup": "popup.html", "default_icon": { "16": "icon16.png", "32": "icon32.png" } },
	"icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" }
}
